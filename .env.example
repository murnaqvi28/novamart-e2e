# Site under test (no trailing slash)
BASE_URL=https://novamart-ot9u.onrender.com

# Optional: Render → novamart service → Environment → TEST_RESET_KEY.
# When set, the database is reset to seed data once before the run.
TEST_RESET_KEY=

# Seeded accounts (defaults match the app's seed data)
ADMIN_EMAIL=admin@novamart.pk
ADMIN_PASSWORD=Admin@123
CUSTOMER_EMAIL=ali@example.com
CUSTOMER_PASSWORD=Customer@123
